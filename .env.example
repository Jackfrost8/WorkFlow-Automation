# AICTE Workflow Automation Platform - Environment Configuration

# Application
APP_NAME="AICTE Workflow Automation Platform"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Server
HOST="127.0.0.1"
PORT=8000

# Security
SECRET_KEY="aicte-super-secret-key-change-this-in-production-workflow-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (SQLite for local demo; easily swapped to postgresql://user:pass@host/db)
DATABASE_URL="sqlite:///./backend/aicte_workflow.db"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=10485760  # 10MB

# Time Simulation
ENABLE_TIME_SIMULATION=true

# Notification / SMTP (Optional Mock)
SMTP_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="no-reply@aicte.gov.in"
